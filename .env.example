# LazyFlow AI Backend Environment Configuration
# Copy this to .env and customize as needed

# AI Provider Settings
LAZYFLOW_AI_PROVIDER=ollama
LAZYFLOW_AI_MODEL=qwen2.5:3b
LAZYFLOW_AI_BASE_URL=http://localhost:11434
LAZYFLOW_AI_REQUEST_TIMEOUT=120
LAZYFLOW_AI_MAX_TOKENS=4096

# Server Settings
LAZYFLOW_HOST=127.0.0.1
LAZYFLOW_PORT=8000
LAZYFLOW_DEBUG=false

# Input Limits
LAZYFLOW_MAX_INPUT_LENGTH=50000
LAZYFLOW_MAX_TITLE_LENGTH=200
